<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Modo Juegos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/grupo_juegos"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_iniciar_modo_juegos"
                        android:layout_width="0dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/accion_iniciar_modo_juegos"
                        style="@style/Widget.GameController.BotonAccion" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_detener_modo_juegos"
                        android:layout_width="0dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/accion_detener_modo_juegos"
                        style="@style/Widget.GameController.BotonAccion" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Steam -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/grupo_steam"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_iniciar_steam"
                        android:layout_width="0dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/accion_iniciar_steam"
                        style="@style/Widget.GameController.BotonAccion" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cerrar_steam"
                        android:layout_width="0dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/accion_cerrar_steam"
                        style="@style/Widget.GameController.BotonAccion" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reiniciar_steam"
                        android:layout_width="0dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/accion_reiniciar_steam"
                        style="@style/Widget.GameController.BotonAccion" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Otros -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/grupo_otros"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cerrar_retroarch"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/accion_cerrar_retroarch"
                        style="@style/Widget.GameController.BotonAccion" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reconectar_mando"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/accion_reconectar_mando"
                        style="@style/Widget.GameController.BotonAccion" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_enfocar_juego"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        android:layout_marginEnd="4dp"
                        android:text="@string/accion_enfocar_juego"
                        style="@style/Widget.GameController.BotonAccion" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_detener_juego"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill_horizontal"
                        android:layout_marginStart="4dp"
                        android:text="@string/accion_detener_juego"
                        style="@style/Widget.GameController.BotonAccion" />

                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Volumen -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/grupo_volumen"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_subir_volumen"
                        android:layout_width="0dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/accion_subir_volumen"
                        style="@style/Widget.GameController.BotonAccion" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_bajar_volumen"
                        android:layout_width="0dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/accion_bajar_volumen"
                        style="@style/Widget.GameController.BotonAccion" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_silenciar"
                        android:layout_width="0dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/accion_silenciar"
                        style="@style/Widget.GameController.BotonAccion" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Equipo -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/grupo_equipo"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_apagar"
                        android:layout_width="0dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/accion_apagar"
                        style="@style/Widget.GameController.BotonAccion" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reiniciar_equipo"
                        android:layout_width="0dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/accion_reiniciar_equipo"
                        style="@style/Widget.GameController.BotonAccion" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
