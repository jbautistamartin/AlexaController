{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // TODO: Configurar credenciales de autenticación básica de la API.
  // Deben coincidir con las configuradas en ngrok (--basic-auth "usuario:contraseña").
  "BasicAuth": {
    "Username": "", // TODO: Introducir el nombre de usuario
    "Password": ""  // TODO: Introducir la contraseña
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5780"
      }
    }
  },
  "SteamPath": "C:\\Program Files (x86)\\Steam\\",
  // Argumentos base de steam.exe (se les anade -gamepadui si SteamBigPicture es true).
  "SteamArgumentos": "-cef-disable-sandbox",
  // Arrancar Steam directamente en modo Big Picture (interfaz de mando).
  "SteamBigPicture": true,
  "JoypadFriendlyName": "F710",
  // Fragmento del identificador de hardware del receptor. Sirve para localizarlo aunque
  // Windows no le haya asignado nombre descriptivo (instalacion fallida, clase vacia).
  "JoypadIdHardware": "VID_046D&PID_C21F",
  // Ciclar tambien el concentrador USB padre al reconectar el mando (equivale a
  // desenchufar el puerto). Afecta al resto de dispositivos del mismo concentrador.
  "JoypadReiniciarConcentradorUsb": true,
  // Procesos cuyas ventanas NO se cierran al iniciar el modo juegos (se suman a la lista interna:
  // explorador de Windows, Steam, JoyToKey y la propia aplicacion).
  "VentanasExcluidas": [],
  // Tiempo maximo de espera a que las ventanas se cierren; las que no lo hagan se minimizan.
  "VentanasEsperaCierreMs": 5000,
  // Mostrar la ventana de progreso al iniciar el modo juegos.
  "MostrarProgreso": true,
  "VolumenPasos": 3,
  // Rutas que identifican al juego lanzado por Steam (coincidencia parcial, sin distinguir mayusculas).
  "PatronesRutaJuegos": [ "steamapps\\common", "C:\\Games" ],
  // Procesos que nunca deben considerarse el juego activo (se suman a la lista interna).
  "ProcesosJuegoExcluidos": [],
  "Procesos": [
    "GoogleDriveFS",
    "GoogleDrive",
    "OneDrive",
    "Dropbox",
    "Greenshot",
    "OfficeClickToRun",
    "ms-teams",
    "Teams",
    "msedge",
    "Zoom",
    "Slack",
    "Discord",
    "Spotify",
    "EpicGamesLauncher",
    "AdobeCollabSync",
    "CCXProcess",
    "outlook",
    "chrome",
    "UniGetUI"
  ],
  // Servicios que se detienen al entrar en modo juegos. Ojo: no incluir "wuauserv";
  // el receptor del mando necesita que Windows Update pueda aportar el driver si se
  // reenumera con el modo juegos ya activo.
  "Servicios": [
    "Fax",
    "Spooler",
    "WSearch",
    "DiagTrack",
    "DPS",
    "TrkWks",
    "PcaSvc",
    "SCardSvr",
    "ScDeviceEnum",
    "WerSvc",
    "FDResPub",
    "RasAuto",
    "RasMan",
    "stisvc",
    "wisvc",
    "WMPNetworkSvc",
    "RetailDemo",
    "MapsBroker",
    "ClickToRunSvc",
    "AJRouter",
    "NetTcpPortSharing",
    "PhoneSvc",
    "MSSQL$SQLEXPRESS",
    "WbioSrvc",
    "lfsvc",
    "WpnService",
    "bthserv",
    "seclogon"
  ]
}